<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jordan HS Aux Gym Backstop Swing Model</title>
<link rel="icon" href="data:,">
<style>
  :root{ color-scheme: light; --red:#C8102E; --mut:#5b6169; --ln:#d6dae0; --ok:#17794a; --wn:#a9760b }
  *{box-sizing:border-box}
  html,body{background:#fff;color:#111;margin:0;padding:14px;font-family:Helvetica,Arial,sans-serif}
  .wrap{max-width:1280px;margin:0 auto}
  h1{font-size:17px;letter-spacing:.02em;text-transform:uppercase;margin:0;border-bottom:3px solid var(--red);padding-bottom:6px}
  h2{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--red);margin:15px 0 4px;display:flex;align-items:center;gap:8px}
  h2 span{color:var(--mut);text-transform:none;letter-spacing:0;font-weight:400}
  h2 button{margin-left:auto;font:inherit;font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;
    border:1px solid var(--ln);background:#f6f7f9;border-radius:3px;cursor:pointer;color:var(--mut)}
  h2 button:hover{background:#eceef1;color:#111}
  .sub{font-size:11.5px;color:var(--mut);margin:8px 0 12px;line-height:1.5}
  .cols{display:grid;grid-template-columns:286px 1fr;gap:16px;align-items:start}
  @media(max-width:900px){.cols{grid-template-columns:1fr}}
  fieldset{border:1px solid var(--ln);border-radius:4px;padding:7px 10px 9px;margin:0 0 9px}
  legend{font-size:9.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--red);padding:0 5px}
  .row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:4px 0;font-size:11.5px}
  .row label{color:var(--mut);flex:1;line-height:1.3}
  .row input[type=number]{width:68px;padding:3px 5px;border:1px solid var(--ln);border-radius:3px;font:inherit;font-size:11.5px;text-align:right}
  .sl{margin:8px 0 4px}
  .sl .lbl{display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:2px;gap:6px}
  .sl .lbl b{font-variant-numeric:tabular-nums;white-space:nowrap}
  .sl input[type=range]{width:100%;accent-color:var(--red)}
  .nudge{display:flex;gap:4px;margin-top:3px}
  .nudge button{flex:1;font:inherit;font-size:10.5px;padding:2px 0;border:1px solid var(--ln);background:#f6f7f9;border-radius:3px;cursor:pointer}
  .nudge button:hover{background:#eceef1}
  .fr{position:relative}
  svg{width:100%;height:auto;display:block;border:1px solid var(--ln);border-radius:4px;background:#fbfcfd}
  .fr.big{position:fixed;inset:10px;z-index:99;background:#fff;border-radius:6px;box-shadow:0 6px 40px rgba(0,0,0,.35);padding:38px 12px 12px;overflow:auto}
  .fr.big svg{max-height:calc(100vh - 76px);width:auto;margin:0 auto}
  .fr .x{display:none}
  .fr.big .x{display:block;position:absolute;top:8px;right:10px;font:inherit;font-size:11px;padding:3px 12px;
    border:1px solid var(--ln);background:#f6f7f9;border-radius:3px;cursor:pointer}
  table{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:4px}
  td,th{text-align:left;padding:4px 7px;border-bottom:1px solid var(--ln);vertical-align:top}
  th{font-size:9.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut)}
  td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  tr.hd td{background:#f4f5f7;font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut)}
  .v{padding:8px 11px;border-radius:4px;font-size:12.5px;margin:8px 0 0;line-height:1.5}
  .g{background:#eaf5ee;border-left:4px solid var(--ok)}
  .y{background:#fdf6e3;border-left:4px solid var(--wn)}
  .r{background:#fdeced;border-left:4px solid var(--red)}
  .note{font-size:10.5px;color:var(--mut);line-height:1.6;margin-top:12px;border-top:1px solid var(--ln);padding-top:9px}
  .pill{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 6px;border-radius:2px;background:var(--red);color:#fff;margin-left:6px;vertical-align:2px}
  .key{font-size:10.5px;color:var(--mut);margin-top:5px}
  .key i{display:inline-block;width:20px;height:0;margin:0 4px -3px 12px}
  .s{display:inline-block;font-size:8.5px;font-weight:700;min-width:15px;padding:1px 2px;text-align:center;border-radius:2px;margin-right:5px;vertical-align:1px;color:#fff}
  .s.p{background:#2f6f3e} .s.f{background:#2b6cb0} .s.m{background:#a9760b} .s.a{background:#6f5aa8} .s.c{background:#71787f}
  .flag{margin:0 0 10px;padding:8px 10px;border-radius:4px;background:#f1f6f2;border-left:4px solid var(--ok);font-size:11.5px;line-height:1.55}
  .opt td:first-child{font-weight:700;white-space:nowrap}
  .opt tr.rec td{background:#eaf5ee}
</style>
</head>
<body>
<div class="wrap">
  <h1>Jordan HS Aux Gym 11162 &mdash; Backstop Swing Model <span class="pill">Working Document</span></h1>
  <div class="sub">
    Units 7 (north, GL 7) and 8 (south). True scale, X and Y equal. The assembly is tracked as two points, the
    <b>mast low point</b> and the <b>rim lip</b>, because the manufacturer's 18'-4 1/2" fold height is measured to the
    rim lip and that is not the point that comes closest to the wall. Every position reads as a
    <b>height above the finish floor</b>.
    <div style="margin-top:8px;padding:6px 9px;background:#f6f7f9;border-radius:4px">
      <span class="s p">P</span>printed on a drawing
      <span class="s f">F</span>field measured
      <span class="s m">M</span>markup or scaled, not printed
      <span class="s a">A</span>assumption
      <span class="s c">C</span>calculated
      &nbsp;&nbsp;<span style="font-size:10.5px">Hover any input for its source. Register at the bottom.</span>
    </div>
  </div>

  <div class="cols">
    <div>
      <fieldset><legend>Backstop unit</legend>
        <div class="row"><label title="Gared sh.14: 24'-9 3/16&quot; MAST HANGER REF"><span class="s p">P</span>Mast hanger el. (ft)</label><input type="number" id="H" value="24.766" step="0.01"></div>
        <div class="row"><label title="NOT printed. Red markup 14'-7 31/32&quot; plus JP scaling. Measured plumb down the mast, so this point sits directly below the hanger."><span class="s m">M</span>Radius to mast low point (ft)</label><input type="number" id="R" value="14.6667" step="0.01"></div>
        <div class="row"><label title="Gared sh.14: 0'-10 13/16&quot; FOB TO MAST HANGER REF"><span class="s p">P</span>Board face to hanger (ft)</label><input type="number" id="f2h" value="0.901" step="0.01"></div>
        <div class="row"><label title="Per JP. Board face out to the outer edge of the rim, the lip."><span class="s a">A</span>Board face to rim lip (ft)</label><input type="number" id="hoop" value="2.5" step="0.0417"></div>
        <div class="row"><label title="Playing height of the rim. Sets the elevation of the lip at play."><span class="s p">P</span>Rim playing height (ft)</label><input type="number" id="rimEl" value="10.0" step="0.5"></div>
        <div class="row"><label title="Gared sh.14: 13'-5 15/16&quot; REF"><span class="s p">P</span>Rear hanger back-span (ft)</label><input type="number" id="rear" value="13.497" step="0.01"></div>
        <div class="row"><label title="Gared sh.14: 18'-4 1/2&quot; FOLD HEIGHT REF, to the rim lip per JP."><span class="s p">P</span>Required fold height (ft)</label><input type="number" id="fold" value="18.375" step="0.0833"></div>
      </fieldset>

      <fieldset><legend>Court striping, 3-A511</legend>
        <div class="row"><label title="3-A511: 84'-0&quot; inside edge to inside edge"><span class="s p">P</span>Court length (ft)</label><input type="number" id="court" value="84.0" step="0.5"></div>
        <div class="row"><label title="3-A511: 50'-0&quot;"><span class="s p">P</span>Court width (ft)</label><input type="number" id="cw" value="50.0" step="0.5"></div>
        <div class="row"><label title="3-A511: 36&quot; border"><span class="s p">P</span>Painted border (ft)</label><input type="number" id="bord" value="3.0" step="0.25"></div>
        <div class="row"><label title="3-A511: 48&quot; end line to face of backboard"><span class="s p">P</span>End line to board face (in)</label><input type="number" id="fobIn" value="48" step="1"></div>
        <div class="row"><label title="3-A511: 63&quot; end line to basket center"><span class="s p">P</span>End line to basket ctr (in)</label><input type="number" id="rimIn" value="63" step="1"></div>
        <div class="row"><label title="Cross-court length, measured across the room. 3-A511 shows the cross courts at the main court width."><span class="s p">P</span>Cross-court length (ft)</label><input type="number" id="xcL" value="50.0" step="0.5"></div>
        <div class="row"><label title="Cross-court width, measured along the main court. 3-A511 dimensions the pair at 42'-2&quot; each."><span class="s p">P</span>Cross-court width (ft)</label><input type="number" id="xcW" value="42.1667" step="0.0833"></div>
        <div class="row"><label title="Per JP, scaled: south cross-court hoop centre, measured from the SOUTH inside end line of the main court. Side-wall mounted, so it does NOT move with the court."><span class="s m">M</span>S cross hoop off S end line (ft)</label><input type="number" id="xcS" value="11.3333" step="0.0833"></div>
        <div class="row"><label title="Per JP, scaled: north cross-court hoop centre, measured from the NORTH inside end line of the main court. Side-wall mounted, so it does NOT move with the court."><span class="s m">M</span>N cross hoop off N end line (ft)</label><input type="number" id="xcN" value="17.1667" step="0.0833"></div>
      </fieldset>

      <fieldset><legend>North soffit framing, GL 7</legend>
        <div class="row"><label title="RCP: 9'-4&quot; inside end line to the lower framing face"><span class="s p">P</span>Lower face to N end line (ft)</label><input type="number" id="NB" value="9.3333" step="0.01"></div>
        <div class="row"><label title="Plan 12'-8&quot; less 9'-4&quot;. Confirmed by the pilaster string: 3'-4&quot; + 16'-8&quot; = 20'-0&quot;, the steel column line."><span class="s p">P</span>Lower face off CMU (ft)</label><input type="number" id="Plow" value="3.3333" step="0.0208"></div>
        <div class="row"><label title="Field tape 46 7/8&quot; + 5/8&quot;. The top of the framing jogs out past the face below it."><span class="s f">F</span>Top of framing off CMU (ft)</label><input type="number" id="P" value="3.958" step="0.0208"></div>
        <div class="row"><label title="Per JP: the jog starts at el 10'-0&quot; off the floor, not at the tip of the slope. That puts the jogged face across the whole swing band, so the jogged face governs."><span class="s f">F</span>Elevation the jog starts (ft)</label><input type="number" id="jogEl" value="10.0" step="0.0833"></div>
        <div class="row"><label title="Red markup on 3-A307/C1: 20'-1 1/2&quot;"><span class="s m">M</span>Top el. at CMU (ft)</label><input type="number" id="sw" value="20.125" step="0.01"></div>
        <div class="row"><label title="Design intent per JP, 18'-5&quot;"><span class="s m">M</span>Top el. at the jog (ft)</label><input type="number" id="sf" value="18.417" step="0.01"></div>
        <div class="row"><label title="Red markup on 3-A307/C1: 20'-0 1/4&quot; CMU to truss / column"><span class="s m">M</span>CMU to column line (ft)</label><input type="number" id="limN" value="20.02" step="0.1"></div>
        <div class="row"><label title="Per JP: the reframe can be isolated to the 16'-8&quot; north wall panel. Must cover the 9'-4&quot; hanger spread."><span class="s f">F</span>Reframe extent (ft)</label><input type="number" id="ext" value="16.6667" step="0.0833"></div>
      </fieldset>

      <fieldset><legend>Room and south end</legend>
        <div class="row"><label title="Per JP field string"><span class="s f">F</span>Room width (ft)</label><input type="number" id="rw" value="74.667" step="0.01"></div>
        <div class="row"><label title="Per JP: 3'-4&quot;. CMU pilasters wrap the steel columns that carry the trusses."><span class="s f">F</span>Pilaster depth (ft)</label><input type="number" id="pd" value="3.3333" step="0.01"></div>
        <div class="row"><label title="Per JP: CMU wrap stops about 1'-0&quot; below the 25'-0&quot; bottom of steel"><span class="s f">F</span>Top of CMU wrap (ft)</label><input type="number" id="ptop" value="24.0" step="0.25"></div>
        <div class="row"><label title="Per JP string"><span class="s f">F</span>S wall to 1st pilaster (ft)</label><input type="number" id="p1" value="9.6667" step="0.01"></div>
        <div class="row"><label title="Per JP string: 20' on center"><span class="s f">F</span>Pilaster spacing (ft)</label><input type="number" id="psp" value="20.0" step="0.01"></div>
        <div class="row"><label title="Per JP string"><span class="s f">F</span>Pilasters each side</label><input type="number" id="pn" value="5" step="1"></div>
        <div class="row"><label title="Per JP string: last pilaster to the lower framing face"><span class="s f">F</span>Last pilaster to N face (ft)</label><input type="number" id="plast" value="16.6667" step="0.01"></div>
        <div class="row"><label title="Floor plan 3-A115: 12'-8&quot; to the inner boundary of striping. Full height wall per JP."><span class="s p">P</span>S end line to wall (ft)</label><input type="number" id="SB" value="12.6667" step="0.01"></div>
        <div class="row"><label title="ASSUMED 5/8&quot; one layer"><span class="s a">A</span>Wall finish build-up (ft)</label><input type="number" id="gwb" value="0.052" step="0.005"></div>
      </fieldset>

      <fieldset><legend>Tolerances</legend>
        <div class="row"><label title="ASSUMED construction clearance"><span class="s a">A</span>Min clearance (in)</label><input type="number" id="clr" value="3" step="1"></div>
        <div class="row"><label title="ASSUMED. Beam clamp is 6 1/2&quot; and may vary in field."><span class="s a">A</span>Min rear attach to wall (in)</label><input type="number" id="rmin" value="10" step="1"></div>
      </fieldset>

      <fieldset><legend>Adjust</legend>
        <div class="sl"><div class="lbl"><span>Shift court south</span><b id="shL">0"</b></div>
          <div id="thr" style="font-size:10px;color:#5b6169;margin:2px 0 3px;line-height:1.45"></div>
          <input type="range" id="shift" min="-24" max="36" step="0.25" value="0">
          <div class="nudge"><button data-nz="-1">&minus;1"</button><button data-nz="-0.25">&minus;1/4"</button>
            <button data-nz="0">0</button><button data-nz="0.25">+1/4"</button><button data-nz="1">+1"</button></div></div>
        <div class="sl"><div class="lbl"><span>Limit switch: stow the rim lip at</span><b id="psL">&mdash;</b></div>
          <input type="range" id="stopH" min="10" max="20" step="0.0208" value="18.375">
          <div class="nudge"><button data-fz="-0.0833">&minus;1"</button><button data-fz="-0.0208">&minus;1/4"</button>
            <button data-fz="0.0208">+1/4"</button><button data-fz="0.0833">+1"</button></div></div>
        <div class="row"><label><input type="checkbox" id="auto" checked> Set to the requirement</label><span></span></div>
      </fieldset>
    </div>

    <div>
      <div id="flag" class="flag"></div>
      <div id="vN" class="v"></div>
      <div id="vS" class="v"></div>

      <h2>Options <span>&mdash; for the RFI</span></h2>
      <table class="opt" id="opt"><tbody></tbody></table>

      <div id="vX" class="v"></div>

      <h2>Shift trade <span>&mdash; what a partial court shift buys</span></h2>
      <table id="trade"><tbody></tbody></table>

      <h2>North detail<span id="tN"></span><button data-big="fN">Enlarge</button></h2>
      <div style="font-size:11px;color:#5b6169;margin:0 0 4px;line-height:1.5">
        <b>Two alternative fixes are drawn, and they are alternatives, not both.</b>
        <span style="color:#17794a;font-weight:700">A, green vertical dashed</span>: move the lower framing face back toward the
        CMU and leave the sloped top where it is.
        <span style="color:#a9760b;font-weight:700">B, amber sloped dashed</span>: leave the face at its present projection and
        drop the front edge of the sloped top instead. Either one clears the same swing.
      </div>
      <div class="fr" id="fN"><button class="x" data-close="fN">Close</button><svg id="detN" viewBox="0 0 600 700"></svg></div>

      <h2>South detail<span id="tS"></span><button data-big="fS">Enlarge</button></h2>
      <div class="fr" id="fS"><button class="x" data-close="fS">Close</button><svg id="detS" viewBox="0 0 600 700"></svg></div>

      <h2>Section, full length<button data-big="fF">Enlarge</button></h2>
      <div class="fr" id="fF"><button class="x" data-close="fF">Close</button><svg id="full" viewBox="0 0 1400 384"></svg></div>
      <div class="key">
        <span><i style="border-top:9px solid #41484f;opacity:.25"></i>sweeps clear</span>
        <span><i style="border-top:9px solid #C8102E;opacity:.35"></i>must still sweep, blocked</span>
        <span><i style="border-top:2px solid #41484f"></i>at play</span>
        <span><i style="border-top:2px solid #C8102E"></i>where it stops</span>
        <span><i style="border-top:2px dashed #C8102E"></i>required stow</span>
      </div>

      <h2>Plan<button data-big="fP">Enlarge</button></h2>
      <div style="font-size:11px;color:#5b6169;margin:0 0 4px;line-height:1.5">
        <span style="color:#7a5ea7;font-weight:700">Purple dashed</span> are the two cross courts, laid out off the main court, so they
        move with any shift. The side-wall goals are drawn solid and <b>do not move</b>. Shift the court and the red tie lines show how
        far each goal falls off its own court centreline.
      </div>
      <div class="fr" id="fP"><button class="x" data-close="fP">Close</button><svg id="plan" viewBox="0 0 1400 900"></svg></div>

      <h2>Numbers</h2>
      <table id="tbl"><tbody></tbody></table>
      <div class="note" id="notes"></div>
    </div>
  </div>
</div>

<script>
(function(){
var $=function(i){return document.getElementById(i)};
function fi(v){var s=v<0?'-':'';v=Math.abs(v);var f=Math.floor(v+1e-9),i=(v-f)*12,n=Math.floor(i+1e-9),q=Math.round((i-n)*16);
  if(q===16){n++;q=0} if(n===12){f++;n=0} var g=function(a,b){return b?g(b,a%b):a},t='';
  if(q){var d=g(q,16);t=' '+(q/d)+'/'+(16/d)} return s+f+"'-"+n+t+'"';}
function IN(v){return Math.abs(v)>=1 ? fi(v) : (v<0?'-':'')+Math.round(Math.abs(v)*12)+'"'}
var IDS=['H','R','f2h','hoop','rimEl','rear','fold','court','cw','bord','fobIn','rimIn','xcL','xcW','xcS','xcN','NB','Plow','P','jogEl','sw','sf','limN','ext',
         'rw','pd','ptop','p1','psp','pn','plast','SB','gwb','clr','rmin','shift','stopH','auto'];
IDS.forEach(function(k){var e=$(k); if(e) e.addEventListener('input',draw)});
document.querySelectorAll('[data-nz]').forEach(function(b){b.addEventListener('click',function(){
  var d=+b.dataset.nz; if(d===0)$('shift').value=0; else $('shift').value=(+$('shift').value+d).toFixed(2); draw()})});
document.querySelectorAll('[data-fz]').forEach(function(b){b.addEventListener('click',function(){
  $('auto').checked=false; $('stopH').value=(+$('stopH').value + +b.dataset.fz).toFixed(4); draw()})});
document.querySelectorAll('[data-big]').forEach(function(b){b.addEventListener('click',function(){
  $(b.dataset.big).classList.add('big'); draw()})});
document.querySelectorAll('[data-close]').forEach(function(b){b.addEventListener('click',function(){
  $(b.dataset.close).classList.remove('big'); draw()})});
document.addEventListener('keydown',function(e){if(e.key==='Escape')
  document.querySelectorAll('.fr.big').forEach(function(f){f.classList.remove('big')})});

function draw(){
  var H=+$('H').value, R=+$('R').value, f2h=+$('f2h').value, hoop=+$('hoop').value, rear=+$('rear').value, fold=+$('fold').value,
      court=+$('court').value, cw=+$('cw').value, bord=+$('bord').value, fobO=+$('fobIn').value/12, rimO=+$('rimIn').value/12,
      xcL=+$('xcL').value, xcW=+$('xcW').value, xcS=+$('xcS').value, xcN=+$('xcN').value,
      rimEl=+$('rimEl').value, NB=+$('NB').value, Plow=+$('Plow').value, P=+$('P').value, jogEl=+$('jogEl').value,
      sw=+$('sw').value, sf=+$('sf').value, limN=+$('limN').value, ext=+$('ext').value,
      rw=+$('rw').value, pd=+$('pd').value, ptop=+$('ptop').value, p1=+$('p1').value, psp=+$('psp').value,
      pn=Math.round(+$('pn').value), plast=+$('plast').value, SB=+$('SB').value, gwb=+$('gwb').value,
      c=+$('clr').value/12, rmin=+$('rmin').value/12, sh=+$('shift').value/12, auto=$('auto').checked;
  $('shL').textContent=(sh*12).toFixed(2).replace(/\.00$/,'')+'"';

  // A: lowest point of the mast, plumb below the hanger. The 14'-8" markup is a vertical dimension.
  // B: the rim lip, board face plus the lip offset, at rim playing height.
  var dyA=Math.max(.5,H-rimEl);
  var PA={R:R, th:0};
  var PB={R:Math.hypot(f2h+hoop,dyA), th:Math.atan2(f2h+hoop,dyA)*180/Math.PI};
  var yPlay=H-R;

  var xELN=Plow+NB+sh, xOBN=xELN-bord, xFOBN=xELN+fobO, xRIMN=xELN+rimO, xHN=xFOBN-f2h, xRN=xHN-rear,
      xELS=xELN+court, xOBS=xELS+bord, xFOBS=xELS-fobO, xRIMS=xELS-rimO, xHS=xFOBS+f2h, xRS=xHS+rear,
      xWALL=Plow+NB+court+SB-gwb;
  var dN=xHN, dS=xWALL-xHS;
  var pil=[]; for(var i=0;i<pn;i++) pil.push(xWALL-(p1+i*psp));
  // Side-wall cross-court goals are FIXED. Their stations are set by the DOCUMENTED court position, shift excluded.
  var xELN0=Plow+NB, xELS0=xELN0+court;
  var xcHS=xELS0-xcS, xcHN=xELN0+xcN;          // absolute stations, never move
  var pilLast=xWALL-(p1+Math.max(pn-1,0)*psp);

  var DIRN=-1, DIRS=1;
